# ─── Discord Bot .env (пример) ───────────────────────────────────────────────
# Скопируйте этот файл в `.env` и заполните реальными значениями.
# config.js читает эти переменные; без них бот не запустится.

# Discord
DISCORD_TOKEN=

# База данных MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# ID гильдии (сервера Discord)
GUILD_ID=

# ─── Steam Web API ──────────────────────────────────────────────────────────
# Обязателен для чтения профилей через официальный API (GetPlayerSummaries).
# Получить ключ: https://steamcommunity.com/dev/apikey
# Без ключа utils/steam.js откатывается на скрейпинг ?xml=1 (может ловить 429).
STEAM_API_KEY=

# ─── FACEIT API ──────────────────────────────────────────────────────────────
# Используется для авто-ролей уровней FACEIT (1-10).
# Получить ключ: https://developers.faceit.com/ → Apps → API Key
FACEIT_API_KEY=
# Игра для определения уровня: cs2 (по умолчанию) или csgo
FACEIT_GAME=cs2
